NODE_ENV=production
PORT=3000
DATABASE_PATH=./data/vph.sqlite
BASE_HOST=vph.example.com
CRYPTO_HOST=pay.example.com
BASE_URL=https://vph.example.com
CRYPTO_BASE_URL=https://pay.example.com

# Create this bot with @BotFather. Never commit real tokens.
BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Optional: auto-set the bot's chat menu button to open the Mini App on startup.
# Leave empty to keep whatever button was configured via BotFather manually.
VPH_MENU_APP_URL=
VPH_MENU_BUTTON_TEXT=Открыть VPH
VPH_SUPPORT_CONTACT=
VPH_OPERATOR_NAME=
VPH_OPERATOR_EMAIL=
VPH_TERMS_URL=
VPH_TERMS_VERSION=2026-10-03-v1

# Optional external crypto checkout. Do not link this checkout from the Telegram Mini App.
CRYPTO_PAY_TOKEN=
CRYPTO_PAY_TESTNET=false

# Marzban panel API and the VLESS inbound configured on that panel.
MARZBAN_URL=https://panel.example.com
MARZBAN_USERNAME=
MARZBAN_PASSWORD=
VPH_PROTOCOL=vless
VPH_INBOUND_TAG=

# Set actual integer Stars and USDT prices before enabling checkout.
VPH_STARS_30=
VPH_STARS_90=
VPH_STARS_180=
VPH_USDT_30=
VPH_USDT_90=
VPH_USDT_180=
